{
  "manifest_version": 3,
  "name": "Kotoba Mirror — Belajar berdampingan",
  "version": "0.3.6",
  "description": "Belajar dua bahasa berdampingan. Scroll dan klik terhubung, furigana Jepang, serta terjemahan khusus teks yang dipilih.",
  "minimum_chrome_version": "138",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Belajar dengan Kotoba Mirror" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
